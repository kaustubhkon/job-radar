<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<style>
  body { margin: 0; padding: 0; background: #f4f4f1; color: #1c1c1a; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.45; }
  .wrap { width: 100%; background: #f4f4f1; }
  .main { max-width: 600px; margin: 0 auto; padding: 20px 14px 28px; }
  .intro { font-size: 14px; color: #5b5b55; margin: 0 0 18px; }
  h2 { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: #6b6b64; margin: 26px 0 8px; font-weight: 600; }
  .card { background: #ffffff; border: 1px solid #e3e3dc; border-radius: 10px; padding: 14px 16px; margin: 0 0 10px; }
  .co { font-size: 13px; color: #5b5b55; font-weight: 600; margin: 0; }
  .title { font-size: 16px; font-weight: 650; margin: 2px 0 4px; color: #1c1c1a; text-decoration: none; }
  .meta { font-size: 13px; color: #6b6b64; margin: 0; }
  .reason { font-size: 14px; color: #2d2d29; margin: 8px 0 12px; }
  .btn { display: inline-block; background: #1f5c4a; color: #ffffff !important; text-decoration: none; font-weight: 600; font-size: 14px; padding: 8px 16px; border-radius: 6px; }
  .score { display: inline-block; font-size: 12px; font-weight: 700; color: #1f5c4a; background: #e4f0eb; border-radius: 4px; padding: 1px 6px; margin-left: 6px; }
  .rows { background: #ffffff; border: 1px solid #e3e3dc; border-radius: 10px; }
  .row { padding: 10px 14px; border-top: 1px solid #efefe9; }
  .row.first { border-top: 0; }
  .row a { color: #1c1c1a; font-weight: 600; text-decoration: none; }
  .row .meta { margin-top: 1px; }
  .muted { color: #8a8a82; }
  .notice { background: #fff6e0; border: 1px solid #f0dca8; border-radius: 8px; padding: 10px 14px; font-size: 14px; margin: 0 0 16px; }
  .more { font-size: 14px; margin: 14px 0 0; }
  .more a { color: #1f5c4a; font-weight: 600; }
  .footer { font-size: 12px; color: #7a7a72; margin-top: 30px; border-top: 1px solid #e3e3dc; padding-top: 12px; }
  .footer a { color: #5b5b55; }
  .src { margin: 0 0 4px; }
  .bad { color: #a33b2b; }
</style>
</head>
<body>
<div class="wrap">
<div class="main">

{% if kind == "failure" %}
  <p class="notice"><strong>Every source failed this run</strong>, so nothing was checked. This is usually temporary (rate limits, an API outage). If it repeats, open the workflow logs.</p>
{% elif kind == "empty" %}
  <p class="intro">Nothing new matched your filters since the last digest. Job Radar is running; this note only goes out {{ "on Mondays" if cfg.email.send_when_empty == "mondays" else "when there's nothing new" }}.</p>
{% elif kind == "backfill" %}
  <p class="intro">Welcome to Job Radar. This is a one-time backfill: the top {{ report.emailed }} of {{ total_matched }} currently open roles that match your profile. From tomorrow you'll only see new postings.</p>
{% else %}
  <p class="intro">{{ report.emailed + overflow }} new posting{{ "s" if (report.emailed + overflow) != 1 }} matched your profile since the last digest.</p>
{% endif %}

{% for note in report.notes %}
  <p class="notice">{{ note }}</p>
{% endfor %}

{% if top %}
<h2>Top picks</h2>
{% for p in top %}
<div class="card">
  <p class="co">{{ p.company }}{% if p.on_watchlist %} <span class="muted">· watchlist</span>{% endif %}</p>
  <a class="title" href="{{ p.url }}">{{ p.title }}</a><span class="score">{{ p.score|round|int }}</span>
  <p class="meta">{{ p.location_label() }}{% if posted(p) %} · {{ posted(p) }}{% endif %}{% if p.compensation %} · {{ p.compensation }}{% endif %}</p>
  {% if p.reason %}<p class="reason">{{ p.reason }}</p>{% else %}<p class="reason"></p>{% endif %}
  <a class="btn" href="{{ p.url }}">Apply</a>
</div>
{% endfor %}
{% endif %}

{% for cat, rows in sections %}
<h2>{{ cat }}</h2>
<div class="rows">
{% for p in rows %}
  <div class="row{% if loop.first %} first{% endif %}">
    <a href="{{ p.url }}">{{ p.title }}</a> <span class="muted">· {{ p.company }}</span>
    <p class="meta">{{ p.location_label() }}{% if posted(p) %} · {{ posted(p) }}{% endif %} · {{ p.score|round|int }}{% if p.reason %} · {{ p.reason }}{% endif %}</p>
  </div>
{% endfor %}
</div>
{% endfor %}

{% if overflow %}
<p class="more">+{{ overflow }} more {% if links.csv %}<a href="{{ links.csv }}">in today's CSV</a>{% else %}in state/runs/ (CSV){% endif %}</p>
{% endif %}

<div class="footer">
  {% for line in source_lines %}
  <p class="src{% if '✗' in line %} bad{% endif %}">{{ line }}</p>
  {% endfor %}
  <p class="src">{{ report.collected }} collected → {{ report.new }} new → {{ report.matched }} matched → {{ report.emailed }} emailed</p>
  {% if links.config %}<p class="src"><a href="{{ links.config }}">Edit your config</a> · <a href="{{ links.runs }}">Run history</a></p>{% endif %}
</div>

</div>
</div>
</body>
</html>
